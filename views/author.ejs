<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portfolio</title>
    <link rel="stylesheet" href="/main.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
    />

    <script src="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/bootstrap.min.js"></script>
  </head>

  <body>
    <div class="frame">
      <div class="main_frame">
        <div class="left_frame">
          <div class="left_1">
            <div class="left_1-1">
              <img
                src="images/profile.png"
                width="156px"
                height="142px"
                alt=""
              />
            </div>
            <div class="left_1-2"><%=user.name%></div>
            <div class="left_1-3"><%=user.profession%></div>
            <div class="left-icons">
              <a class="link_href" href="">
                <div class="icon">
                  <img src="icon/Facebook.svg" class="icon-1" />
                </div>
              </a>
              <a class="link_href" href="">
                <div class="icon">
                  <img src="icon/Instagram.svg" class="icon-1" />
                </div>
              </a>
              <a class="link_href" href="">
                <div class="icon">
                  <img src="icon/Linkeding.svg" class="icon-1" />
                </div>
              </a>
              <a class="link_href" href="">
                <div class="icon">
                  <img src="icon/Twitter.svg" class="icon-1" />
                </div>
              </a>
              <a class="link_href" href="">
                <div class="icon">
                  <img src="icon/Youtube.svg" class="icon-1" />
                </div>
              </a>
            </div>
          </div>
          <div class="marginer"></div>
          <div class="left_2">
            <div class="about-p">
              <div class="about-p-info">Age:</div>
              <div><%=user.age%></div>
            </div>
            <div class="about-p">
              <div class="about-p-info">Residence:</div>
              <div><%=user.residence%></div>
            </div>
            <div class="about-p">
              <div class="about-p-info">Freelance:</div>
              <div>Available</div>
            </div>
            <div class="about-p">
              <div class="about-p-info">Address:</div>
              <div><%=user.adress%></div>
            </div>
          </div>
          <div class="marginer"></div>
          <div class="left_3">
            <div class="info-titles">Languages</div>

            <div class="skill-title">
              <span><%=user.languages[0]%></span>
              <span>100%</span>
            </div>
            <div class="progress">
              <div class="progress-fill p100"></div>
            </div>
            <div class="skill-title">
              <span><%=user.languages[1]%></span>
              <span>80%</span>
            </div>
            <div class="progress">
              <div class="progress-fill p80"></div>
            </div>
            <div class="skill-title">
              <span><%=user.languages[2]%></span>
              <span>80%</span>
            </div>
            <div class="progress">
              <div class="progress-fill p80"></div>
            </div>
          </div>
          <div class="marginer"></div>
          <div class="left_4">
            <div class="info-titles">Skills</div>

            <div class="skill-title">
              <span><%=user.skills[0]%></span>
              <span>90%</span>
            </div>
            <div class="progress">
              <div class="progress-fill p90"></div>
            </div>
            <div class="skill-title">
              <span><%=user.skills[1]%></span>
              <span>85%</span>
            </div>
            <div class="progress">
              <div class="progress-fill p85"></div>
            </div>
            <div class="skill-title">
              <span><%=user.skills[2]%></span>
              <span>80%</span>
            </div>
            <div class="progress">
              <div class="progress-fill p80"></div>
            </div>
            <div class="skill-title">
              <span><%=user.skills[3]%></span>
              <span>75%</span>
            </div>
            <div class="progress">
              <div class="progress-fill p75"></div>
            </div>
            <div class="skill-title">
              <span><%=user.skills[4]%></span>
              <span>85%</span>
            </div>
            <div class="progress">
              <div class="progress-fill p85"></div>
            </div>
          </div>
          <div class="marginer"></div>
          <div class="left_5">
            <div class="info-titles">Extra Skills</div>

            <div>
              <span class="extra-icon">
                <img src="icon/icons.png" class="icon-2" />
              </span>
              <span> <%=user.extra_skills[0]%> </span>
            </div>
            <div>
              <span class="extra-icon">
                <img src="icon/icons.png" class="icon-2" />
              </span>
              <span> <%=user.extra_skills[1]%> </span>
            </div>
            <div>
              <span class="extra-icon">
                <img src="icon/icons.png" class="icon-2" />
              </span>
              <span> <%=user.extra_skills[2]%> </span>
            </div>
            <div>
              <span class="extra-icon">
                <img src="icon/icons.png" class="icon-2" />
              </span>
              <span> <%=user.extra_skills[3]%> </span>
            </div>
          </div>
          <div class="marginer"></div>
        </div>
        <div class="midd_frame">
          <div class="midd_frame_top">
            <span class="figure-icon-1">
              <img src="btn_icon/Ellipse 15.png" class="figure-icons-img" />
            </span>
            <span class="figure-icon-2">
              <img src="btn_icon/Ellipse 16.png" class="figure-icons-img" />
            </span>
            <span class="figure-icon-3">
              <img src="btn_icon/Rectangle 52.png" class="figure-icons-img" />
            </span>
            <span class="figure-icon-4">
              <img src="btn_icon/Ellipse 12.png" class="figure-icons-img" />
            </span>
            <span class="figure-icon-5">
              <img src="btn_icon/Ellipse 13.png" class="figure-icons-img" />
            </span>
            <span class="figure-icon-6">
              <img src="btn_icon/Rectangle 51.png" class="figure-icons-img" />
            </span>
            <span class="figure-icon-7">
              <img src="btn_icon/Polygon 1.png" class="figure-icons-img" />
            </span>
            <div class="midd_frame_top_left">
              <div class="work_place"><%=user.work_place%></div>
              <div class="service_desc">
                <%=user.about_me%> <%=user.service_desc%>
              </div>
              <button class="hire_me">
                HIRE ME
                <img src="btn_icon/Frame.png" />
              </button>
            </div>
            <div class="midd_frame_top_right">
              <img class="your_image" src="images/Your Image 1.png" />
            </div>
          </div>
          <div class="midd_frame_bottom">
            <div class="midd_frame_bottom_txt">
              <div class="my_services_txt">My Services</div>
              <div class="midd_frame_bottom_service_desc">
                <%=user.service_desc%>
              </div>
            </div>
            <div class="midd_frame_bottom_bot">
              <div class="my_services">
                <div class="my_services_img">
                  <img src="box_images/coding.png"/>
                </div>
                <div class="my_service_dir">
                  Web Development
                </div>
                <div class="my_service_dir_type">
                  Blog, E-Commerce
                </div>
              </div>
              <div class="my_services">
                <div class="my_services_img">
                  <img src="box_images/Icons_illustration.png"/>
                </div>
                <div class="my_service_dir">
                  UI/UX Design
                </div>
                <div class="my_service_dir_type">
                  Mobile App, Website Design
                </div>
              </div>
              <div class="my_services">
                <div class="my_services_img">
                  <img src="box_images/Icons_Microphone.png"/>
                </div>
                <div class="my_service_dir">
                  Sound Design
                </div>
                <div class="my_service_dir_type">
                  Voice Over, Beat Making
                </div>
              </div>
              <div class="my_services">
                <div class="my_services_img">
                  <img src="box_images/Icons_game-development.png"/>
                </div>
                <div class="my_service_dir">
                  Game Design
                </div>
                <div class="my_service_dir_type">
                  Character Design, Props & Objects
                </div>
              </div>
              <div class="my_services">
                <div class="my_services_img">
                  <img src="box_images/Icons_Photographer.png"/>
                </div>
                <div class="my_service_dir">
                  Photography
                </div>
                <div class="my_service_dir_type">
                  Portrait, Product Photography
                </div>
              </div>
              <div class="my_services">
                <div class="my_services_adv">
                  Advertising
                </div>
                <div class="my_service_dir2">
                  <%=user.about_me%>
                </div>
                <div class="my_service_dir_adv2">
                  OFFER NOW >
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="right_frame">
          <button class="menu-icons menu-icons-exept">  
            <img src="menu_icon/Vector1.png"/>
            <span class="tooltip-txt">Contrast</span>
            <img class="tooltip-img" src="menu_icon/Union.png"/>
          </button >
          <button  class="menu-icons">
            <img src="menu_icon/Icons_Home.png"/>
            <span class="tooltip-txt">Home</span>
            <img class="tooltip-img" src="menu_icon/Union.png"/>
          </button >
          <button  class="menu-icons">
            <img src="menu_icon/file-code.png"/>
            <span class="tooltip-txt">Service</span>
            <img class="tooltip-img" src="menu_icon/Union.png"/>
          </button >
          <button  class="menu-icons">
            <img src="menu_icon/cv.png"/>
            <span class="tooltip-txt">CV</span>
            <img class="tooltip-img" src="menu_icon/Union.png"/>
          </button >
          <button  class="menu-icons">
            <img src="menu_icon/Vector.png"/>
            <span class="tooltip-txt">Portfolio</span>
            <img class="tooltip-img" src="menu_icon/Union.png"/>
          </button >
          <button  class="menu-icons">
            <img src="menu_icon/Blog.png"/>
            <span class="tooltip-txt">Blog</span>
            <img class="tooltip-img" src="menu_icon/Union.png"/>
          </button >
          <button  class="menu-icons">
            <img src="menu_icon/Icons_Contact.png"/>
            <span class="tooltip-txt">Contact</span>
            <img class="tooltip-img" src="menu_icon/Union.png"/>
          </button >
        </div>
      </div>
    </div>
  </body>
</html>
